# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# API-Football (https://www.api-football.com/ - tiene plan gratuito, 100 req/dia)
# Se usa para estadisticas de los ultimos 10 partidos por equipo (corners, goles, tarjetas)
API_FOOTBALL_KEY=tu-api-key-aqui

# Ventana de analisis (horas hacia adelante)
HOURS_AHEAD=4

# Cada cuanto corre el ciclo completo (minutos)
RUN_INTERVAL_MINUTES=30

# Filtros del prompt original
MIN_ODDS=2.0
MIN_VALUE_PERCENT=5.0
MIN_VALID_MATCHES=6

# Navegador visible del scraper de BetPlay (poner true en servidor sin pantalla)
BETPLAY_HEADLESS=false

# Segunda fuente gratuita de respaldo (https://www.football-data.org/, registro gratis).
# Se usa solo cuando API-Football no devuelve datos suficientes. Su plan free no
# incluye corners/tarjetas, solo goles.
FOOTBALL_DATA_API_KEY=tu-api-key-aqui

# Tercer respaldo: estadisticas via navegador automatizado contra el Modo IA
# de Google Search (la pestana "Modo IA" debajo del buscador, no el chat de
# gemini.google.com), usado solo cuando ninguna de las dos APIs anteriores
# tiene datos suficientes.
# AVISO: esto automatiza la UI de consumidor de Google, lo cual va contra sus
# Terminos de Servicio y puede causar el bloqueo de la cuenta usada. Requiere
# login manual una vez (correr con GOOGLE_AI_HEADLESS=false la primera vez).
GOOGLE_AI_URL=https://www.google.com/search?udm=50
GOOGLE_AI_PROFILE_DIR=.google_ai_profile
GOOGLE_AI_HEADLESS=false
